<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IndoPlayHub.UI.CourtsPage"
             Title="Court &amp; Facility Management"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" MaximumWidthRequest="600" HorizontalOptions="Center">

            <!-- Header Section -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="Manage Arena Courts" FontSize="26" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                <Label Text="Add and configure sports facilities with optional add-ons" FontSize="13" TextColor="#9E9E9E" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Form Card -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="12" HasShadow="False" BorderColor="#2C2C2C" Padding="25">
                <VerticalStackLayout Spacing="18">
                    <Label Text="Register New Court / Pitch" FontSize="16" FontAttributes="Bold" TextColor="#BB86FC"/>

                    <!-- Court Name Input -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Court Name / Identifier" FontSize="12" TextColor="#B0B0B0"/>
                        <Entry x:Name="TxtCourtName" 
                               Placeholder="e.g., Futsal Turf A, Badminton Court 1" 
                               TextColor="White" 
                               BackgroundColor="#252525"/>
                    </VerticalStackLayout>

                    <!-- Sport Category Picker (Loaded from Database) -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Sport Category" FontSize="12" TextColor="#B0B0B0"/>
                        <Picker x:Name="PickerCategory" 
                                Title="Select Sport Type" 
                                ItemDisplayBinding="{Binding CategoryName}"
                                TextColor="White" 
                                BackgroundColor="#252525"/>
                    </VerticalStackLayout>

                    <!-- Price Input -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Base Price Per Hour (Rs.)" FontSize="12" TextColor="#B0B0B0"/>
                        <Entry x:Name="TxtPrice" 
                               Placeholder="e.g., 3500" 
                               Keyboard="Numeric" 
                               TextColor="White" 
                               BackgroundColor="#252525"/>
                    </VerticalStackLayout>

                    <!-- Professional Add-ons Section -->
                    <BoxView HeightRequest="1" BackgroundColor="#2C2C2C" Margin="0,5"/>
                    <Label Text="Optional Facility Add-ons (Extra Hourly Fees)" FontSize="13" FontAttributes="Bold" TextColor="#BB86FC"/>

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="ChkFloodlights" Color="#BB86FC" VerticalOptions="Center"/>
                        <Label Text="Include Premium Night Floodlights (+Rs. 500/hr)" FontSize="12" TextColor="#E0E0E0" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="ChkEquipment" Color="#BB86FC" VerticalOptions="Center"/>
                        <Label Text="Equipment Rental Bundle - Balls/Rackets (+Rs. 300/hr)" FontSize="12" TextColor="#E0E0E0" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Submit Button -->
                    <Button Text="Save &amp; Register Court" 
                            BackgroundColor="#BB86FC" 
                            TextColor="#121212" 
                            FontAttributes="Bold" 
                            HeightRequest="48" 
                            CornerRadius="8" 
                            Clicked="OnSaveCourtClicked" 
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Existing Courts Header -->
            <Label Text="Registered Courts &amp; Facilities" FontSize="18" FontAttributes="Bold" TextColor="White" Margin="0,10,0,0"/>

            <!-- List of Courts -->
            <CollectionView x:Name="CollectionViewCourts" HeightRequest="250">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,5" HasShadow="False" BorderColor="#2C2C2C">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label Text="{Binding ItemName}" FontAttributes="Bold" FontSize="15" TextColor="White"/>
                                    <Label Text="{Binding PricePerHour, StringFormat='Base Rate: Rs. {0:N0} / hr'}" FontSize="12" TextColor="#03DAC6"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" 
                                        Text="Remove" 
                                        BackgroundColor="#CF6679" 
                                        TextColor="White" 
                                        FontSize="11" 
                                        HeightRequest="35" 
                                        CornerRadius="6"
                                        CommandParameter="{Binding ItemID}"
                                        Clicked="OnDeleteCourtClicked"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>