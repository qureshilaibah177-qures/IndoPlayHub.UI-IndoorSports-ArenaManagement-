<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="IndoPlayHub.UI.CustomerBookingConfirmationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#101114"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="0"
            Padding="20,18,20,12"
            ColumnDefinitions="Auto,*,Auto"
            ZIndex="10">

            <Border
                Grid.Column="0"
                WidthRequest="44"
                HeightRequest="44"
                BackgroundColor="#191B20"
                Stroke="#292D35"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <Label
                    Text="‹"
                    FontSize="30"
                    TextColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnBackTapped" />
                </Border.GestureRecognizers>

            </Border>

            <Label
                Grid.Column="1"
                Text="Booking Confirmed"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Label
                Grid.Column="2"
                Text="✓"
                FontSize="21"
                TextColor="#03DAC6"
                VerticalOptions="Center" />

        </Grid>


        <!-- ===================================================== -->
        <!-- CONTENT -->
        <!-- ===================================================== -->

        <ScrollView
            Grid.Row="1"
            VerticalScrollBarVisibility="Never">

            <VerticalStackLayout
                Padding="20,8,20,40"
                Spacing="18">


                <!-- ================================================= -->
                <!-- SUCCESS -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    Spacing="8"
                    HorizontalOptions="Center"
                    Margin="0,12,0,8">

                    <Border
                        WidthRequest="76"
                        HeightRequest="76"
                        BackgroundColor="#12302D"
                        Stroke="#03DAC6"
                        StrokeThickness="2"
                        HorizontalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="38" />
                        </Border.StrokeShape>

                        <Label
                            Text="✓"
                            FontSize="42"
                            FontAttributes="Bold"
                            TextColor="#03DAC6"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                    <Label
                        Text="Booking Confirmed!"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Your booking has been successfully saved."
                        FontSize="13"
                        TextColor="#8F96A3"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- BOOKING ID -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#12302D"
                    Stroke="#1E514C"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="5"
                        HorizontalOptions="Center">

                        <Label
                            Text="BOOKING ID"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#8F96A3"
                            HorizontalTextAlignment="Center" />

                        <Label
                            x:Name="LblBookingID"
                            Text="#0000"
                            FontSize="25"
                            FontAttributes="Bold"
                            TextColor="#03DAC6"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- BOOKING DETAILS -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#191B20"
                    Stroke="#292D35"
                    StrokeThickness="1"
                    Padding="20">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="17">

                        <Label
                            Text="Booking Details"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White" />


                        <!-- ARENA -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12">

                            <Label
                                Text="🏟️"
                                FontSize="22"
                                VerticalOptions="Start" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="ARENA"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#8F96A3" />

                                <Label
                                    x:Name="LblArenaName"
                                    Text="Arena"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                            </VerticalStackLayout>

                        </Grid>


                        <!-- LOCATION -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12">

                            <Label
                                Text="📍"
                                FontSize="20"
                                VerticalOptions="Start" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="LOCATION"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#8F96A3" />

                                <Label
                                    x:Name="LblLocation"
                                    Text="Location"
                                    FontSize="14"
                                    TextColor="#D0D3D8" />

                            </VerticalStackLayout>

                        </Grid>


                        <!-- SPORT -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12">

                            <Label
                                Text="🏅"
                                FontSize="20"
                                VerticalOptions="Start" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="SPORT"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#8F96A3" />

                                <Label
                                    x:Name="LblSport"
                                    Text="Sport"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                            </VerticalStackLayout>

                        </Grid>


                        <!-- COURT -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12">

                            <Label
                                Text="🎯"
                                FontSize="20"
                                VerticalOptions="Start" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="COURT"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#8F96A3" />

                                <Label
                                    x:Name="LblCourt"
                                    Text="Court"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                            </VerticalStackLayout>

                        </Grid>


                        <!-- DATE -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12">

                            <Label
                                Text="📅"
                                FontSize="20"
                                VerticalOptions="Start" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="DATE"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#8F96A3" />

                                <Label
                                    x:Name="LblBookingDate"
                                    Text="Date"
                                    FontSize="15"
                                    TextColor="#D0D3D8" />

                            </VerticalStackLayout>

                        </Grid>


                        <!-- TIME -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12">

                            <Label
                                Text="🕐"
                                FontSize="20"
                                VerticalOptions="Start" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="TIME"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#8F96A3" />

                                <Label
                                    x:Name="LblBookingTime"
                                    Text="Time"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                            </VerticalStackLayout>

                        </Grid>


                        <!-- CUSTOMER -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12">

                            <Label
                                Text="👤"
                                FontSize="20"
                                VerticalOptions="Start" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="CUSTOMER"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#8F96A3" />

                                <Label
                                    x:Name="LblCustomerName"
                                    Text="Customer"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                                <Label
                                    x:Name="LblCustomerPhone"
                                    Text="Phone"
                                    FontSize="13"
                                    TextColor="#B7BBC3" />

                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- PAYMENT INFORMATION -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#191B20"
                    Stroke="#292D35"
                    StrokeThickness="1"
                    Padding="20">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="14">

                        <Label
                            Text="Payment Information"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White" />


                        <Grid
    ColumnDefinitions="*,Auto">

                            <Label
        Grid.Column="0"
        Text="Payment Method"
        FontSize="14"
        TextColor="#B7BBC3"
        VerticalOptions="Center" />

                            <Label
        Grid.Column="1"
        x:Name="LblPaymentMethod"
        Text="Pay at Venue"
        FontSize="14"
        FontAttributes="Bold"
        TextColor="White"
        HorizontalOptions="End"
        VerticalOptions="Center" />

                        </Grid>


                        <Grid
    ColumnDefinitions="*,Auto">

                            <Label
        Grid.Column="0"
        Text="Payment Status"
        FontSize="14"
        TextColor="#B7BBC3"
        VerticalOptions="Center" />

                            <Label
        Grid.Column="1"
        x:Name="LblPaymentStatus"
        Text="Pending"
        FontSize="14"
        FontAttributes="Bold"
        TextColor="#FFB74D"
        HorizontalOptions="End"
        VerticalOptions="Center" />

                        </Grid>


                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#292D35" />


                        <Grid
    ColumnDefinitions="*,Auto">

                            <Label
        Grid.Column="0"
        Text="Total Amount"
        FontSize="18"
        FontAttributes="Bold"
        TextColor="White"
        VerticalOptions="Center" />

                            <Label
        Grid.Column="1"
        x:Name="LblTotalAmount"
        Text="Rs. 0"
        FontSize="22"
        FontAttributes="Bold"
        TextColor="#03DAC6"
        HorizontalOptions="End"
        VerticalOptions="Center" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- BOOKING STATUS -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#12302D"
                    Stroke="#1E514C"
                    StrokeThickness="1"
                    Padding="15">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10">

                        <Label
                            Text="✓"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#03DAC6"
                            VerticalOptions="Start" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3">

                            <Label
                                Text="BOOKING STATUS"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#8F96A3" />

                            <Label
                                x:Name="LblBookingStatus"
                                Text="Confirmed"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#03DAC6" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- DONE BUTTON -->
                <!-- ================================================= -->

                <Button
                    Text="Back to Home"
                    Clicked="OnBackTapped"
                    HeightRequest="56"
                    CornerRadius="16"
                    BackgroundColor="#03DAC6"
                    TextColor="#101114"
                    FontSize="17"
                    FontAttributes="Bold"
                    Margin="0,5,0,0" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>