<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="IndoPlayHub.UI.EditSportPage"
    Title="Edit Sport"
    BackgroundColor="#0B0F14">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="18"
            MaximumWidthRequest="900"
            HorizontalOptions="Center">

            <!-- ===================================================== -->
            <!-- HEADER -->
            <!-- ===================================================== -->

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="14"
                Margin="0,8,0,4">

                <Button
                    Grid.Column="0"
                    Text="‹"
                    FontSize="28"
                    BackgroundColor="#151B23"
                    TextColor="White"
                    WidthRequest="48"
                    HeightRequest="48"
                    CornerRadius="14"
                    Clicked="OnBackClicked" />

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">

                    <Label
                        Text="SPORT MANAGEMENT"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="#BB86FC"
                        CharacterSpacing="1.5" />

                    <Label
                        Text="Edit Sport"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="Manage your sport, pricing and playing units."
                        FontSize="12"
                        TextColor="#7F8A99" />

                </VerticalStackLayout>

            </Grid>


            <!-- ===================================================== -->
            <!-- SPORT INFORMATION -->
            <!-- ===================================================== -->

            <Border
                BackgroundColor="#151B23"
                Stroke="#29313D"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                Padding="18">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="SPORT INFORMATION"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#9AA4B2"
                        CharacterSpacing="1" />

                    <!-- Sport -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="SPORT"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#7F8A99" />

                        <Label
                            x:Name="LblSportName"
                            Text="Sport"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="White" />

                    </VerticalStackLayout>


                    <!-- Category -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="CATEGORY"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#7F8A99" />

                        <Label
                            x:Name="LblCategory"
                            Text="Sports"
                            FontSize="13"
                            TextColor="#D0D5DD" />

                    </VerticalStackLayout>


                    <!-- Price -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="PRICE PER HOUR"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#7F8A99" />

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">

                            <Label
                                Text="Rs."
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#03DAC6"
                                VerticalOptions="Center" />

                            <Entry
                                x:Name="TxtPrice"
                                Grid.Column="1"
                                Placeholder="Enter hourly price"
                                Keyboard="Numeric"
                                FontSize="15"
                                TextColor="White"
                                PlaceholderColor="#657080"
                                BackgroundColor="#1B222C" />

                        </Grid>

                    </VerticalStackLayout>


                    <!-- Business Hours -->

                    <Grid
    ColumnDefinitions="*,*"
    ColumnSpacing="12">

                        <VerticalStackLayout
        Grid.Column="0"
        Spacing="5">

                            <Label
            Text="OPENING TIME"
            FontSize="10"
            FontAttributes="Bold"
            TextColor="#7F8A99" />

                            <TimePicker
            x:Name="TpOpeningTime"
            Format="HH:mm"
            TextColor="White"
            BackgroundColor="#1B222C"
            FontSize="14" />

                        </VerticalStackLayout>


                        <VerticalStackLayout
        Grid.Column="1"
        Spacing="5">

                            <Label
            Text="CLOSING TIME"
            FontSize="10"
            FontAttributes="Bold"
            TextColor="#7F8A99" />

                            <TimePicker
            x:Name="TpClosingTime"
            Format="HH:mm"
            TextColor="White"
            BackgroundColor="#1B222C"
            FontSize="14" />

                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </Border>


            <!-- ===================================================== -->
            <!-- PLAYING UNITS -->
            <!-- ===================================================== -->

            <Grid
                ColumnDefinitions="*,Auto"
                Margin="0,4,0,0">

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="2">

                    <Label
                        Text="PLAYING UNITS"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="Manage courts and individual playing areas."
                        FontSize="12"
                        TextColor="#7F8A99" />

                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    BackgroundColor="#1B222C"
                    Stroke="#29313D"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="10,7"
                    VerticalOptions="Center">

                    <HorizontalStackLayout Spacing="5">

                        <Label
                            Text="UNITS"
                            FontSize="9"
                            FontAttributes="Bold"
                            TextColor="#7F8A99" />

                        <Label
                            x:Name="LblUnitCount"
                            Text="0"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#BB86FC" />

                    </HorizontalStackLayout>

                </Border>

            </Grid>


            <!-- ===================================================== -->
            <!-- UNITS LIST -->
            <!-- ===================================================== -->

            <CollectionView
                x:Name="CvUnits"
                SelectionMode="None">

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="10" />

                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>

                    <Border
                        BackgroundColor="#151B23"
                        Stroke="#29313D"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="22">

                        <VerticalStackLayout
                            Spacing="7"
                            HorizontalOptions="Center">

                            <Label
                                Text="🏟️"
                                FontSize="30"
                                HorizontalOptions="Center" />

                            <Label
                                Text="No playing units"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalOptions="Center" />

                            <Label
                                Text="Add your first unit below."
                                FontSize="11"
                                TextColor="#7F8A99"
                                HorizontalOptions="Center" />

                        </VerticalStackLayout>

                    </Border>

                </CollectionView.EmptyView>


                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            BackgroundColor="#151B23"
                            Stroke="#29313D"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 15"
                            Padding="14">

                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="12">

                                <!-- Icon -->

                                <Border
                                    Grid.Column="0"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="#252D38"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="🏟️"
                                        FontSize="19"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />

                                </Border>


                                <!-- Information -->

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding ItemName}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Label
                                        Text="{Binding PriceText}"
                                        FontSize="11"
                                        TextColor="#03DAC6" />

                                    <Label
                                        Text="{Binding BookingStatusText}"
                                        FontSize="10"
                                        TextColor="#9AA4B2" />

                                </VerticalStackLayout>


                                <!-- Edit -->

                                <Button
                                    Grid.Column="2"
                                    Text="✏ Edit"
                                    BackgroundColor="#252D38"
                                    TextColor="#BB86FC"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    CornerRadius="9"
                                    HeightRequest="40"
                                    WidthRequest="78"
                                    VerticalOptions="Center"
                                    Clicked="OnEditUnitClicked" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>


            <!-- ===================================================== -->
            <!-- ADD UNIT -->
            <!-- ===================================================== -->

            <Button
                Text="＋  Add Playing Unit"
                BackgroundColor="#1B222C"
                TextColor="#BB86FC"
                BorderColor="#BB86FC"
                BorderWidth="1"
                FontSize="13"
                FontAttributes="Bold"
                CornerRadius="11"
                HeightRequest="48"
                Clicked="OnAddUnitClicked" />


            <!-- ===================================================== -->
            <!-- SAVE -->
            <!-- ===================================================== -->

            <Button
                x:Name="BtnSave"
                Text="SAVE SPORT CHANGES"
                BackgroundColor="#BB86FC"
                TextColor="#0B0F14"
                FontSize="13"
                FontAttributes="Bold"
                CornerRadius="11"
                HeightRequest="52"
                Margin="0,4,0,0"
                Clicked="OnSaveClicked" />


            <Label
                Text="Changes are saved directly to your arena database."
                FontSize="10"
                TextColor="#4F5967"
                HorizontalOptions="Center"
                Margin="0,-8,0,15" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>