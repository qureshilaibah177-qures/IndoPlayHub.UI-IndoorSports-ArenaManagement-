<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IndoPlayHub.UI.RegisterArenaPage"
             Title="Business Portal | Registration"
             BackgroundColor="#121212">

    <ScrollView>
        <!-- Main Wrapper Container -->
        <VerticalStackLayout Padding="40" Spacing="25" MaximumWidthRequest="800" HorizontalOptions="Center">

            <!-- Header Section -->
            <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                <BoxView WidthRequest="5" HeightRequest="40" Color="#BB86FC" CornerRadius="2"/>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Arena Registration Portal" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="White"/>
                    <Label Text="Register your indoor facility to manage courts, menus, and bookings." 
                           FontSize="13" 
                           TextColor="#9E9E9E"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Section 1: Ownership & Security Details -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="12" HasShadow="False" BorderColor="#2C2C2C" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="1. Ownership &amp; Security" FontAttributes="Bold" TextColor="#BB86FC" FontSize="15"/>

                    <!-- Owner Name & CNIC Row -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Owner Name" FontSize="12" TextColor="#B0B0B0"/>
                            <Entry x:Name="TxtOwnerName" Placeholder="e.g. Muhammad Ali" TextColor="White" BackgroundColor="#252525"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Owner CNIC" FontSize="12" TextColor="#B0B0B0"/>
                            <Entry x:Name="TxtOwnerCNIC" Placeholder="36302-XXXXXXX-X" Keyboard="Numeric" TextColor="White" BackgroundColor="#252525"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Owner ID & Email Row -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Owner ID" FontSize="12" TextColor="#B0B0B0"/>
                            <Entry x:Name="TxtOwnerID" Placeholder="e.g. 1" Keyboard="Numeric" TextColor="White" BackgroundColor="#252525"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Business Email" FontSize="12" TextColor="#B0B0B0"/>
                            <Entry x:Name="TxtEmail" Placeholder="owner@domain.com" Keyboard="Email" TextColor="White" BackgroundColor="#252525"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Passwords Row (Side by Side) -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Password" FontSize="12" TextColor="#B0B0B0"/>
                            <Entry x:Name="TxtPassword" Placeholder="Enter password" IsPassword="True" TextColor="White" BackgroundColor="#252525"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Confirm Password" FontSize="12" TextColor="#B0B0B0"/>
                            <Entry x:Name="TxtConfirmPassword" Placeholder="Re-enter password" IsPassword="True" TextColor="White" BackgroundColor="#252525"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Section 2: Facility & Location -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="12" HasShadow="False" BorderColor="#2C2C2C" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="2. Facility Information" FontAttributes="Bold" TextColor="#BB86FC" FontSize="15"/>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Business / Arena Name" FontSize="12" TextColor="#B0B0B0"/>
                        <Entry x:Name="TxtArenaName" Placeholder="e.g. Multan Indoor Sports Complex" TextColor="White" BackgroundColor="#252525"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Complete Address / Location" FontSize="12" TextColor="#B0B0B0"/>
                        <Entry x:Name="TxtLocation" Placeholder="e.g. Near Bosan Road, Multan" TextColor="White" BackgroundColor="#252525"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Section 3: Contact & Media -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="12" HasShadow="False" BorderColor="#2C2C2C" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="3. Contact &amp; Media" FontAttributes="Bold" TextColor="#BB86FC" FontSize="15"/>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Phone Number" FontSize="12" TextColor="#B0B0B0"/>
                            <Entry x:Name="TxtPhone" Placeholder="061-4589234" Keyboard="Telephone" TextColor="White" BackgroundColor="#252525"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Cover Image URL" FontSize="12" TextColor="#B0B0B0"/>
                            <Entry x:Name="TxtCoverImage" Placeholder="https://..." TextColor="White" BackgroundColor="#252525"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Action Button Footer -->
            <Button Text="Complete Registration &amp; Save" 
                    BackgroundColor="#BB86FC" 
                    TextColor="#121212" 
                    FontAttributes="Bold"
                    FontSize="15"
                    HeightRequest="50"
                    CornerRadius="8"
                    Clicked="OnRegisterClicked"
                    Margin="0,10,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>