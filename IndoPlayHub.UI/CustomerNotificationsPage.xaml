<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="IndoPlayHub.UI.CustomerNotificationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Notifications"
    BackgroundColor="#F6F7FB">

    <Grid RowDefinitions="Auto,*">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <Grid
            Grid.Row="0"
            Padding="20,18"
            BackgroundColor="White"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="3">

                <Label
                    Text="Notifications"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="#172033" />

                <Label
                    x:Name="LblNotificationSummary"
                    Text="Your latest updates"
                    FontSize="13"
                    TextColor="#7A8294" />

            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                x:Name="BtnMarkAllRead"
                Text="Mark all read"
                FontSize="13"
                Padding="14,8"
                CornerRadius="18"
                BackgroundColor="#EEF2FF"
                TextColor="#4F46E5"
                Clicked="OnMarkAllReadClicked" />

        </Grid>


        <!-- =====================================================
             NOTIFICATION CONTENT
             ===================================================== -->

        <Grid Grid.Row="1">

            <!-- =================================================
                 LOADING
                 ================================================= -->

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsVisible="False"
                IsRunning="False"
                HorizontalOptions="Center"
                VerticalOptions="Center" />


            <!-- =================================================
                 EMPTY STATE
                 ================================================= -->

            <VerticalStackLayout
                x:Name="EmptyState"
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="30"
                Spacing="10">

                <Label
                    Text="🔔"
                    FontSize="48"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="No notifications yet"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#172033"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="We'll show your booking and account updates here."
                    FontSize="14"
                    TextColor="#7A8294"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- =================================================
                 NOTIFICATION LIST
                 ================================================= -->

            <CollectionView
                x:Name="NotificationsCollection"
                SelectionMode="None"
                Margin="14,12">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,0,0,10"
                            Padding="16"
                            StrokeThickness="1"
                            Stroke="#E5E7EB"
                            BackgroundColor="White">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>


                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="5">


                                <!-- =================================
                                     NOTIFICATION ICON
                                     ================================= -->

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    BackgroundColor="#EEF2FF"
                                    StrokeThickness="0"
                                    VerticalOptions="Start">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="21" />
                                    </Border.StrokeShape>

                                    <Label
                                        Text="🔔"
                                        FontSize="19"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />

                                </Border>


                                <!-- =================================
                                     TITLE
                                     ================================= -->

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Title}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#172033"
                                    LineBreakMode="TailTruncation" />


                                <!-- =================================
                                     UNREAD INDICATOR
                                     ================================= -->

                                <!--
                                    The unread indicator will be
                                    handled later when we add the
                                    visual unread-state converter.
                                -->

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    WidthRequest="9"
                                    HeightRequest="9"
                                    BackgroundColor="#4F46E5"
                                    StrokeThickness="0"
                                    IsVisible="False">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="5" />
                                    </Border.StrokeShape>

                                </Border>


                                <!-- =================================
                                     MESSAGE
                                     ================================= -->

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Message}"
                                    FontSize="14"
                                    TextColor="#5F6778"
                                    LineBreakMode="WordWrap" />


                                <!-- =================================
                                     DATE
                                     ================================= -->

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding CreatedAt,
                                                  StringFormat='{0:dd MMM yyyy, hh:mm tt}'}"
                                    FontSize="11"
                                    TextColor="#9AA1B1" />


                                <!-- =================================
                                     MARK AS READ
                                     ================================= -->

                                <Button
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Text="Read"
                                    FontSize="11"
                                    Padding="10,4"
                                    CornerRadius="12"
                                    BackgroundColor="#F3F4F6"
                                    TextColor="#4B5563"
                                    CommandParameter="{Binding NotificationID}"
                                    Clicked="OnMarkAsReadClicked" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>

</ContentPage>