<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="IndoPlayHub.UI.ChangeCustomerPasswordPage"
    Title="Change Password"
    BackgroundColor="#101114">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            MaximumWidthRequest="600"
            HorizontalOptions="Center">

            <!-- HEADER -->

            <VerticalStackLayout Spacing="5">

                <Label
                    Text="Change Password"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="Update your account password securely."
                    FontSize="13"
                    TextColor="#9CA3AF" />

            </VerticalStackLayout>


            <!-- PASSWORD CARD -->

            <Border
                BackgroundColor="#191B20"
                Stroke="#292D35"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <!-- CURRENT PASSWORD -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Current Password"
                            FontSize="12"
                            TextColor="#B8BDC7" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Entry
                                x:Name="TxtCurrentPassword"
                                Grid.Column="0"
                                Placeholder="Enter current password"
                                PlaceholderColor="#70757F"
                                TextColor="White"
                                BackgroundColor="#23262D"
                                IsPassword="True" />

                            <Button
                                x:Name="BtnCurrentPassword"
                                Grid.Column="1"
                                Text="Show"
                                Clicked="OnToggleCurrentPasswordClicked"
                                BackgroundColor="#23262D"
                                TextColor="#BB86FC"
                                FontSize="12"
                                WidthRequest="65"
                                Margin="5,0,0,0" />

                        </Grid>

                    </VerticalStackLayout>


                    <!-- NEW PASSWORD -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="New Password"
                            FontSize="12"
                            TextColor="#B8BDC7" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Entry
                                x:Name="TxtNewPassword"
                                Grid.Column="0"
                                Placeholder="Enter new password"
                                PlaceholderColor="#70757F"
                                TextColor="White"
                                BackgroundColor="#23262D"
                                IsPassword="True" />

                            <Button
                                x:Name="BtnNewPassword"
                                Grid.Column="1"
                                Text="Show"
                                Clicked="OnToggleNewPasswordClicked"
                                BackgroundColor="#23262D"
                                TextColor="#BB86FC"
                                FontSize="12"
                                WidthRequest="65"
                                Margin="5,0,0,0" />

                        </Grid>

                    </VerticalStackLayout>


                    <!-- CONFIRM PASSWORD -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Confirm New Password"
                            FontSize="12"
                            TextColor="#B8BDC7" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Entry
                                x:Name="TxtConfirmPassword"
                                Grid.Column="0"
                                Placeholder="Confirm new password"
                                PlaceholderColor="#70757F"
                                TextColor="White"
                                BackgroundColor="#23262D"
                                IsPassword="True" />

                            <Button
                                x:Name="BtnConfirmPassword"
                                Grid.Column="1"
                                Text="Show"
                                Clicked="OnToggleConfirmPasswordClicked"
                                BackgroundColor="#23262D"
                                TextColor="#BB86FC"
                                FontSize="12"
                                WidthRequest="65"
                                Margin="5,0,0,0" />

                        </Grid>

                    </VerticalStackLayout>


                    <!-- PASSWORD RULES -->

                    <Label
                        Text="Use at least 6 characters for your new password."
                        FontSize="12"
                        TextColor="#8F96A3" />


                    <!-- SAVE BUTTON -->

                    <Button
                        Text="Change Password"
                        Clicked="OnChangePasswordClicked"
                        BackgroundColor="#BB86FC"
                        TextColor="#111114"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="10"
                        Margin="0,5,0,0" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>