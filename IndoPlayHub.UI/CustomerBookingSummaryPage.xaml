

<ContentPage
    x:Class="IndoPlayHub.UI.CustomerBookingSummaryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Booking Summary"
    BackgroundColor="#101114">

    <Grid RowDefinitions="Auto,*">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="0"
            Padding="20,18"
            ColumnDefinitions="Auto,*">

            <Label
                Grid.Column="0"
                Text="‹"
                FontSize="36"
                TextColor="White"
                VerticalOptions="Center">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnBackTapped" />
                </Label.GestureRecognizers>

            </Label>

            <Label
                Grid.Column="1"
                Text="Booking Summary"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center"
                HorizontalOptions="Center" />

        </Grid>


        <!-- ===================================================== -->
        <!-- CONTENT -->
        <!-- ===================================================== -->

        <ScrollView
            Grid.Row="1">

            <VerticalStackLayout
                Padding="20,10,20,40"
                Spacing="18">


                <!-- ================================================= -->
                <!-- INTRO -->
                <!-- ================================================= -->

                <Label
                    Text="Review your booking"
                    FontSize="27"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="Please check the details below before confirming."
                    FontSize="14"
                    TextColor="#A8ADB7"
                    Margin="0,-10,0,5" />


                <!-- ================================================= -->
                <!-- BOOKING DETAILS -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#191B20"
                    Stroke="#292D35"
                    StrokeThickness="1"
                    Padding="20">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="16">

                        <Label
                            Text="Booking Details"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="White" />


                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="ARENA"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#8F96A3" />

                            <Label
                                x:Name="LblArenaName"
                                Text="Arena"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="White" />

                        </VerticalStackLayout>


                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="LOCATION"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#8F96A3" />

                            <Label
                                x:Name="LblLocation"
                                Text="Location"
                                FontSize="15"
                                TextColor="#D0D3D8" />

                        </VerticalStackLayout>


                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="SPORT"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#8F96A3" />

                            <Label
                                x:Name="LblSport"
                                Text="Sport"
                                FontSize="15"
                                TextColor="#D0D3D8" />

                        </VerticalStackLayout>


                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="COURT"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#8F96A3" />

                            <Label
                                x:Name="LblCourt"
                                Text="Court"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="White" />

                        </VerticalStackLayout>


                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="DATE"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#8F96A3" />

                            <Label
                                x:Name="LblBookingDate"
                                Text="Date"
                                FontSize="15"
                                TextColor="#D0D3D8" />

                        </VerticalStackLayout>


                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="TIME"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#8F96A3" />

                            <Label
                                x:Name="LblBookingTime"
                                Text="Time"
                                FontSize="15"
                                TextColor="#D0D3D8" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- CUSTOMER -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#191B20"
                    Stroke="#292D35"
                    StrokeThickness="1"
                    Padding="20">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="16">

                        <Label
                            Text="Customer Information"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="White" />


                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="NAME"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#8F96A3" />

                            <Label
                                x:Name="LblCustomerName"
                                Text="Customer"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="White" />

                        </VerticalStackLayout>


                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="PHONE"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#8F96A3" />

                            <Label
                                x:Name="LblCustomerPhone"
                                Text="Phone"
                                FontSize="15"
                                TextColor="#D0D3D8" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- PAYMENT METHOD -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#191B20"
                    Stroke="#292D35"
                    StrokeThickness="1"
                    Padding="20">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="14">

                        <Label
                            Text="Payment Method"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Choose how you want to pay."
                            FontSize="13"
                            TextColor="#A8ADB7" />


                        <!-- ================================================= -->
                        <!-- PAY AT VENUE -->
                        <!-- ================================================= -->

                        <Border
                            x:Name="PayAtVenueBorder"
                            BackgroundColor="#202329"
                            Stroke="#03DAC6"
                            StrokeThickness="2"
                            Padding="12">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnPayAtVenueTapped" />
                            </Border.GestureRecognizers>

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12">

                                <RadioButton
                                    x:Name="RbPayAtVenue"
                                    Grid.Column="0"
                                    IsChecked="True"
                                    GroupName="PaymentMethod"
                                    CheckedChanged="OnPaymentMethodChanged"
                                    VerticalOptions="Center" />

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2">

                                    <Label
                                        Text="Pay at Venue"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Label
                                        Text="Pay cash when you arrive at the arena."
                                        FontSize="13"
                                        TextColor="#A8ADB7" />

                                </VerticalStackLayout>

                            </Grid>

                        </Border>


                        <!-- ================================================= -->
                        <!-- ONLINE PAYMENT -->
                        <!-- ================================================= -->

                        <Border
                            x:Name="OnlinePaymentBorder"
                            BackgroundColor="#191B20"
                            Stroke="#292D35"
                            StrokeThickness="1"
                            Padding="12">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnOnlinePaymentTapped" />
                            </Border.GestureRecognizers>

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12">

                                <RadioButton
                                    x:Name="RbOnlinePayment"
                                    Grid.Column="0"
                                    IsChecked="False"
                                    GroupName="PaymentMethod"
                                    CheckedChanged="OnPaymentMethodChanged"
                                    VerticalOptions="Center" />

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2">

                                    <Grid
                                        ColumnDefinitions="*,Auto">

                                        <Label
                                            Grid.Column="0"
                                            Text="Online Payment"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="White" />

                                        <Border
                                            Grid.Column="1"
                                            BackgroundColor="#3A3422"
                                            Padding="8,3">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>

                                            <Label
                                                Text="COMING SOON"
                                                FontSize="9"
                                                FontAttributes="Bold"
                                                TextColor="#FFD166" />

                                        </Border>

                                    </Grid>

                                    <Label
                                        Text="Card, JazzCash and Easypaisa will be available later."
                                        FontSize="13"
                                        TextColor="#A8ADB7" />

                                </VerticalStackLayout>

                            </Grid>

                        </Border>


                        <!-- ================================================= -->
                        <!-- PAYMENT NOTE -->
                        <!-- ================================================= -->

                        <Label
                            x:Name="LblPaymentNote"
                            Text="You will pay at the arena when you arrive."
                            FontSize="13"
                            TextColor="#03DAC6"
                            Margin="2,2,0,0" />

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- PRICE BREAKDOWN -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#191B20"
                    Stroke="#292D35"
                    StrokeThickness="1"
                    Padding="20">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="14">

                        <Label
                            Text="Price Details"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="White" />


                        <Grid
                            ColumnDefinitions="*,Auto">

                            <Label
                                Text="Court Price"
                                FontSize="15"
                                TextColor="#B8BDC6" />

                            <Label
                                x:Name="LblCourtPrice"
                                Grid.Column="1"
                                Text="Rs. 0"
                                FontSize="15"
                                TextColor="White" />

                        </Grid>


                        <Grid
                            ColumnDefinitions="*,Auto">

                            <Label
                                Text="Service Fee"
                                FontSize="15"
                                TextColor="#B8BDC6" />

                            <Label
                                x:Name="LblServiceFee"
                                Grid.Column="1"
                                Text="Rs. 0"
                                FontSize="15"
                                TextColor="White" />

                        </Grid>


                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#292D35"
                            Margin="0,2" />


                        <Grid
                            ColumnDefinitions="*,Auto">

                            <Label
                                Text="Total"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                x:Name="LblTotalAmount"
                                Grid.Column="1"
                                Text="Rs. 0"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#03DAC6" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- LOADING -->
                <!-- ================================================= -->

                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    IsVisible="False"
                    IsRunning="False"
                    Color="#03DAC6"
                    HorizontalOptions="Center"
                    Margin="0,0,0,4" />


                <!-- ================================================= -->
                <!-- CONFIRM -->
                <!-- ================================================= -->

                <Button
                    x:Name="BtnConfirmBooking"
                    Text="Confirm Booking"
                    Clicked="OnConfirmBookingClicked"
                    HeightRequest="56"
                    CornerRadius="16"
                    BackgroundColor="#03DAC6"
                    TextColor="#101114"
                    FontSize="17"
                    FontAttributes="Bold"
                    IsEnabled="False"
                    Margin="0,5,0,0" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>

