<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="IndoPlayHub.UI.ManageSportsPage"
    Title="Manage Sports"
    BackgroundColor="#0B0F14">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="18"
            MaximumWidthRequest="1200"
            HorizontalOptions="Center">

            <!-- ===================================================== -->
            <!-- HEADER -->
            <!-- ===================================================== -->

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12"
                Margin="0,8,0,0">

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="4">

                    <Label
                        Text="SPORTS MANAGEMENT"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#BB86FC"
                        CharacterSpacing="1.5" />

                    <Label
                        Text="Manage Your Sports"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="Add, edit and manage the playing areas in your arena."
                        FontSize="13"
                        TextColor="#9AA4B2" />

                </VerticalStackLayout>

                <Button
                    Grid.Column="1"
                    Text="＋ Add Sport"
                    BackgroundColor="#BB86FC"
                    TextColor="#0B0F14"
                    FontSize="12"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="44"
                    Padding="16,0"
                    Clicked="OnAddSportClicked" />

            </Grid>


            <!-- ===================================================== -->
            <!-- SUMMARY -->
            <!-- ===================================================== -->

            <Border
                BackgroundColor="#151B23"
                Stroke="#29313D"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15"
                Padding="16">

                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="12">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="3">

                        <Label
                            Text="REGISTERED SPORTS"
                            FontSize="9"
                            FontAttributes="Bold"
                            TextColor="#7F8A99" />

                        <Label
                            x:Name="LblTotalSports"
                            Text="0"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="#BB86FC" />

                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3">

                        <Label
                            Text="TOTAL UNITS"
                            FontSize="9"
                            FontAttributes="Bold"
                            TextColor="#7F8A99" />

                        <Label
                            x:Name="LblTotalUnits"
                            Text="0"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="#FFB74D" />

                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="2"
                        Spacing="3">

                        <Label
                            Text="ARENA HOURS"
                            FontSize="9"
                            FontAttributes="Bold"
                            TextColor="#7F8A99" />

                        <Label
                            x:Name="LblArenaHours"
                            Text="08:00 - 23:00"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#03DAC6"
                            VerticalOptions="Center" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- ===================================================== -->
            <!-- SPORTS LIST HEADER -->
            <!-- ===================================================== -->

            <VerticalStackLayout
                Spacing="3"
                Margin="0,5,0,0">

                <Label
                    Text="REGISTERED SPORTS"
                    FontSize="19"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="Each sport can have multiple courts or playing units."
                    FontSize="12"
                    TextColor="#7F8A99" />

            </VerticalStackLayout>


            <!-- ===================================================== -->
            <!-- SPORTS -->
            <!-- ===================================================== -->

            <CollectionView
                x:Name="CvSports"
                SelectionMode="None">

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="12" />

                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>

                    <Border
                        BackgroundColor="#151B23"
                        Stroke="#29313D"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="30">

                        <VerticalStackLayout
                            Spacing="8"
                            HorizontalOptions="Center">

                            <Label
                                Text="🏟️"
                                FontSize="38"
                                HorizontalOptions="Center" />

                            <Label
                                Text="No sports configured"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalOptions="Center" />

                            <Label
                                Text="Add your first sport to start managing your playing areas."
                                FontSize="11"
                                TextColor="#7F8A99"
                                HorizontalTextAlignment="Center"
                                HorizontalOptions="Center" />

                            <Button
                                Text="＋ Add First Sport"
                                BackgroundColor="#BB86FC"
                                TextColor="#0B0F14"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="9"
                                HeightRequest="42"
                                Margin="0,8,0,0"
                                Clicked="OnAddSportClicked" />

                        </VerticalStackLayout>

                    </Border>

                </CollectionView.EmptyView>


                <!-- ================================================= -->
                <!-- SPORT ITEM -->
                <!-- ================================================= -->

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            BackgroundColor="#151B23"
                            Stroke="#29313D"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">

                            <VerticalStackLayout
                                Spacing="14">

                                <!-- SPORT HEADER -->

                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="12">

                                    <!-- Sport icon -->

                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        BackgroundColor="#252D38"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14">

                                        <Label
                                            Text="{Binding SportIcon}"
                                            FontSize="25"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />

                                    </Border>


                                    <!-- Sport name -->

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding SportName}"
                                            FontSize="19"
                                            FontAttributes="Bold"
                                            TextColor="White" />

                                        <Label
                                            Text="{Binding UnitText}"
                                            FontSize="11"
                                            TextColor="#9AA4B2" />

                                    </VerticalStackLayout>


                                    <!-- Edit -->

                                    <Button
                                        Grid.Column="2"
                                        Text="✏ Edit"
                                        BackgroundColor="#252D38"
                                        TextColor="#BB86FC"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        CornerRadius="9"
                                        HeightRequest="38"
                                        Padding="14,0"
                                        CommandParameter="{Binding}"
                                        Clicked="OnEditSportClicked" />

                                </Grid>


                                <!-- DIVIDER -->

                                <BoxView
                                    HeightRequest="1"
                                    BackgroundColor="#29313D" />


                                <!-- DETAILS -->

                                <Grid
                                    ColumnDefinitions="*,*"
                                    RowDefinitions="Auto,Auto"
                                    ColumnSpacing="15"
                                    RowSpacing="12">

                                    <!-- Units -->

                                    <VerticalStackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Spacing="3">

                                        <Label
                                            Text="PLAYING UNITS"
                                            FontSize="9"
                                            FontAttributes="Bold"
                                            TextColor="#7F8A99" />

                                        <Label
                                            Text="{Binding UnitText}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            TextColor="#FFB74D" />

                                    </VerticalStackLayout>


                                    <!-- Rate -->

                                    <VerticalStackLayout
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Spacing="3">

                                        <Label
                                            Text="AVERAGE RATE"
                                            FontSize="9"
                                            FontAttributes="Bold"
                                            TextColor="#7F8A99" />

                                        <Label
                                            Text="{Binding RateText}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            TextColor="#03DAC6" />

                                    </VerticalStackLayout>


                                    <!-- Hours -->

                                    <VerticalStackLayout
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Spacing="3">

                                        <Label
                                            Text="BUSINESS HOURS"
                                            FontSize="9"
                                            FontAttributes="Bold"
                                            TextColor="#7F8A99" />

                                        <Label
                                            Text="{Binding BusinessHours}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="White" />

                                    </VerticalStackLayout>


                                    <!-- Availability -->

                                    <VerticalStackLayout
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Spacing="3">

                                        <Label
                                            Text="AVAILABLE UNITS"
                                            FontSize="9"
                                            FontAttributes="Bold"
                                            TextColor="#7F8A99" />

                                        <Label
                                            Text="{Binding AvailableUnitsText}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="#03DAC6" />

                                    </VerticalStackLayout>

                                </Grid>


                                <!-- ACTION -->

                                <Button
                                    Text="⚙ Manage Sport &amp; Units"
                                    BackgroundColor="#1B222C"
                                    TextColor="#D0D5DD"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    CornerRadius="9"
                                    HeightRequest="42"
                                    CommandParameter="{Binding}"
                                    Clicked="OnEditSportClicked" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>


            <!-- ===================================================== -->
            <!-- INFORMATION -->
            <!-- ===================================================== -->

            <Border
                BackgroundColor="#121820"
                Stroke="#29313D"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="14">

                <Label
                    Text="💡 Tip: You can add new sports or increase the number of playing units without logging out or repeating the arena setup."
                    FontSize="11"
                    TextColor="#9AA4B2"
                    LineBreakMode="WordWrap" />

            </Border>


            <!-- ===================================================== -->
            <!-- FOOTER -->
            <!-- ===================================================== -->

            <Label
                Text="IndoPlayHub • Sports Management"
                FontSize="10"
                TextColor="#4F5967"
                HorizontalOptions="Center"
                Margin="0,5,0,20" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>